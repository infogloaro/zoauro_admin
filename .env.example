# Copy to .env and fill in. Never commit .env. Placeholders only.
NODE_ENV=development
APP_URL=http://localhost:3000
WEB_INTERNAL_API_URL=http://localhost:4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me
ENCRYPTION_KEY=change-me
# 2-step verification (doc 52): its own secret, at least 32 characters, different from SESSION_SECRET and ENCRYPTION_KEY.
OTP_HMAC_KEY=dev-only-otp-hmac-key-change-me-0123456789
# Only while rotating ENCRYPTION_KEY: the previous value, so secrets sealed with it still open.
# ENCRYPTION_KEY_PREVIOUS=
MFA_ISSUER=ZOAURO Admin
# SMS one-time codes stay off until a real provider and a DLT template exist (doc 52 section 6). console = local only.
SMS_PROVIDER=none
S3_BUCKET=zoauro-local
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
SMTP_URL=smtp://localhost:1025
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
INTEGRATION_CLOCK_SKEW_SEC=300
INTEGRATION_WEBHOOK_TIMEOUT_MS=10000
INTEGRATION_FEED_RETENTION_DAYS=14
INTEGRATION_LOG_RETENTION_DAYS=90
ONLINE_PAYMENT_EXPIRY_MIN=15
SENTRY_DSN=
LOG_LEVEL=info
# Proxies in front of the API that may set X-Forwarded-For: 0 locally, 1 behind one Nginx.
TRUST_PROXY_HOPS=0
INITIAL_SUPERADMIN_EMAIL=admin@example.com
INITIAL_SUPERADMIN_PASSWORD=change-me
