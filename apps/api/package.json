{
  "name": "@zoauro/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsup src/server.ts src/worker.ts --format esm --out-dir dist",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env scripts/prisma-migrate.mjs",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "demo:seed": "tsx --env-file-if-exists=.env scripts/demo-seed.ts seed",
    "demo:assign": "tsx --env-file-if-exists=.env scripts/demo-seed.ts assign",
    "demo:orders": "tsx --env-file-if-exists=.env scripts/seed-sample-orders.ts",
    "db:generate": "prisma generate",
    "audit:seed": "tsx --env-file-if-exists=.env scripts/seed-audit.ts",
    "postinstall": "prisma generate",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "cli": "tsx --env-file-if-exists=.env src/cli/index.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@zoauro/shared": "workspace:*",
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "10.0.11",
    "otplib": "13.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "openapi-typescript": "7.13.0",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
