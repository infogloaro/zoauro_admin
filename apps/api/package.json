{
  "name": "@zoauro/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "smoke:start": "tsup && node scripts/smoke-start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env scripts/prisma-migrate.mjs",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "demo:seed": "tsx --env-file-if-exists=.env scripts/demo-seed.ts seed",
    "demo:assign": "tsx --env-file-if-exists=.env scripts/demo-seed.ts assign",
    "demo:env": "tsx scripts/demo/demo.ts env",
    "demo:db": "tsx scripts/demo/demo.ts db",
    "demo:reset": "tsx scripts/demo/demo.ts db --reset",
    "demo:build": "tsx scripts/demo/demo.ts build",
    "demo:api": "tsx scripts/demo/demo.ts api",
    "demo:api:dev": "tsx --env-file=.env.demo src/server.ts",
    "demo:worker": "tsx scripts/demo/demo.ts worker",
    "demo:web": "tsx scripts/demo/demo.ts web",
    "demo:data": "tsx --env-file=.env.demo scripts/demo/seed.ts",
    "db:generate": "prisma generate",
    "audit:seed": "tsx --env-file-if-exists=.env scripts/seed-audit.ts",
    "postinstall": "prisma generate",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "cli": "tsx --env-file-if-exists=.env src/cli/index.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@zoauro/shared": "workspace:*",
    "bullmq": "6.3.11",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "10.0.11",
    "otplib": "13.5.0",
    "pg": "^8.23.1",
    "socket.io": "4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "openapi-typescript": "7.13.0",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
