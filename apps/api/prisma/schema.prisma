  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  @@index([zoneId, status])
  @@index([hotelId, checkIn])
  @@map("room_bookings")
}

model DiningReservation {
  id            String               @id @db.Uuid
  zoneId        String               @map("zone_id") @db.Uuid
  hotelId       String?              @map("hotel_id") @db.Uuid
  restaurantId  String?              @map("restaurant_id") @db.Uuid // CHECK exactly one of hotel/restaurant: SQL
  customerName  String               @map("customer_name")
  customerPhone String               @map("customer_phone")
  reservedDate  DateTime             @map("reserved_date") @db.Date
  reservedTime  String               @map("reserved_time") @db.VarChar(5)
  guests        Int // CHECK >= 1: SQL
  tableArea     String?              @map("table_area") @db.VarChar(80)
  status        DiningStatus         @default(PENDING)
  paymentStatus BookingPaymentStatus @default(PENDING) @map("payment_status")
  amount        Int? // paise, CHECK >= 0: SQL
  note          String?              @db.VarChar(300)
  version       Int                  @default(1)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz
  createdBy     String?              @map("created_by") @db.Uuid
  updatedBy     String?              @map("updated_by") @db.Uuid

  zone       Zone        @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  hotel      Hotel?      @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([zoneId, status])
  @@index([hotelId, reservedDate])
  @@index([restaurantId])
  @@map("dining_reservations")
