}

model DataSubjectRequest {
  id          String    @id @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  type        String // values not given in doc 08 (see handoff)
  status      String // values not given in doc 08 (see handoff)
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  handledBy   String?   @map("handled_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  handler  User?    @relation(fields: [handledBy], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("data_subject_requests")
