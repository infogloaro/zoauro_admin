// doc 59 §4, D115 (roadmap R13): a Zonal Admin asks for a zone or for one permission in a zone; a Super Admin decides.
// One open request per requester + zone + permission: a partial unique index written by hand in the migration.
model AccessRequest {
  id             String              @id @db.Uuid
  requesterId    String              @map("requester_id") @db.Uuid
  kind           AccessRequestKind
  zoneId         String              @map("zone_id") @db.Uuid
  module         String? // PERMISSION only; must be grantable
  action         AccessAction? // PERMISSION only
  reason         String
  status         AccessRequestStatus @default(PENDING)
  decidedBy      String?             @map("decided_by") @db.Uuid
  decidedAt      DateTime?           @map("decided_at") @db.Timestamptz
  decisionReason String?             @map("decision_reason")
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  requester User  @relation("AccessRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  decider   User? @relation("AccessRequestDecidedBy", fields: [decidedBy], references: [id], onDelete: Restrict)
  zone      Zone  @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([requesterId, createdAt])
  @@map("access_requests")
}

