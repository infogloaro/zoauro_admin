enum NotificationKind {
  MESSAGE
  PROMOTION
}

enum NotificationStatus {
  PENDING_APPROVAL
  SCHEDULED
  SENT
  CANCELLED
  FAILED
  REJECTED
}

enum NotificationAudience {
  CUSTOMERS
  VENDORS
  PARTNERS
  ALL
}

