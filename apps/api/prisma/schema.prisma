  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("settings")
}

model Coupon {
  id         String    @id @db.Uuid
  code       String // unique where deleted_at IS NULL (constraints migration)
  zoneId     String?   @map("zone_id") @db.Uuid
  type       String // values not given in doc 08 (see handoff)
