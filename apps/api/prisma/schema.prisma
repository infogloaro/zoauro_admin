  PREPARING
  READY
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
  WALLET
}

enum PaymentSubMethod {
  UPI
  CARD
}

enum RefundStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSED
  FAILED
  REJECTED
}

enum RefundTarget {
  GATEWAY
  WALLET
  MANUAL
}

enum PayeeType {
  RESTAURANT
  HOMEMAKER
  DELIVERY_PARTNER
}

enum ReviewTargetType {
  RESTAURANT
  DELIVERY
  FOOD_ITEM
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  HIDDEN
}

enum ZoneAssignmentStatus {
  ASSIGNED
  UNASSIGNED
}

enum RecordSource {
  APP
  ADMIN
  IMPORT
}

enum RestaurantKind {
  RESTAURANT
  SHOP
}

enum ApiClientType {
  CUSTOMER_APP
  VENDOR_APP
  PARTNER_APP
}

enum ApiEnvironment {
