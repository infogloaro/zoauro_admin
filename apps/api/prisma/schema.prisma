// ZOAURO admin schema (F1.1). Source: docs/B-architecture/08 (v1.2 + v2.0 integration tables), enums from 08 and 10 section 5.
// UUID v7 ids are generated by the application (no database default). Money is integer paise. Timestamps are UTC (timestamptz).
// Constraints Prisma cannot express (CHECKs, partial unique indexes, trigram search) live in the second migration.
// AuditLog is copied from docs/F-execution/m04-bundle/apps/api/prisma/audit.model.prisma, not derived from doc 08.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ===========================================================================
// ENUMS (doc 08 "Enums" plus every value list written inline in doc 08; PartnerStatus from doc 10 section 5)
// ===========================================================================

enum RoleName {
  SUPER_ADMIN
  ZONAL_ADMIN
}

enum AccessAction {
  VIEW
  ADD
  EDIT
  DELETE
  STATUS
  EXPORT // D149: per-module export (the zone flag canExport stays the master switch)
}

enum OverrideEffect {
  GRANT
  DENY
}

enum AccessChangeType {
  PROFILE_SET
  OVERRIDE_SET
  LIMIT_SET
  ZONE_ADDED
  ZONE_REMOVED
  PROFILE_EDITED
}

// D92: services a zone can run (the list also lives in @zoauro/shared ZONE_SERVICES)
enum ZoneServiceKind {
  RESTAURANTS
  HOME_FOOD
  HOTEL_BOOKING
}

// doc 59 §4, D115
enum AccessRequestKind {
  ZONE
  PERMISSION
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ZoneStatus {
  ACTIVE
  INACTIVE
  UPCOMING
}

// how a serviceable pincode was added (doc 53 section 3)
enum PincodeSource {
  RANGE
  MANUAL
  IMPORT
}

enum VendorStatus {
