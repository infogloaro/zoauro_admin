/// D136: one send per zone, each at its own promotion window; a zone is never sent twice.
model NotificationZoneSend {
  id             String                 @id @db.Uuid
  notificationId String                 @map("notification_id") @db.Uuid
  zoneId         String                 @map("zone_id") @db.Uuid
  sendAt         DateTime               @map("send_at") @db.Timestamptz
  status         NotificationSendStatus @default(PENDING)
  sentAt         DateTime?              @map("sent_at") @db.Timestamptz
  emailsSent     Int                    @default(0) @map("emails_sent")
  emailsFailed   Int                    @default(0) @map("emails_failed")
  failureNote    String?                @map("failure_note")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  zone         Zone         @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@unique([notificationId, zoneId])
  @@index([status, sendAt])
  @@map("notification_zone_sends")
}

// ---- support desk (D139-D141) -------------------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  ASSIGNED
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

/// D141: ADMIN only in v1, APP after D18
enum TicketSource {
  ADMIN
  APP
}

enum TicketMessageVisibility {
  PUBLIC
  INTERNAL
}

model SupportTicket {
  id                 String         @id @db.Uuid
  ticketNo           String         @unique @map("ticket_no") // "TCK-" + 8 characters, set by the service
  zoneId             String         @map("zone_id") @db.Uuid
  customerId         String         @map("customer_id") @db.Uuid
  orderId            String?        @map("order_id") @db.Uuid
  refundId           String?        @map("refund_id") @db.Uuid
  category           String // values in shared code (ORDER, PAYMENT_REFUND, DELIVERY, ACCOUNT, OTHER)
  priority           TicketPriority @default(NORMAL)
  status             TicketStatus   @default(OPEN)
  source             TicketSource   @default(ADMIN)
  subject            String // CHECK 1..200 characters: SQL
  assigneeId         String?        @map("assignee_id") @db.Uuid
  assignedAt         DateTime?      @map("assigned_at") @db.Timestamptz // round-robin = least recently assigned member
  firstResponseDueAt DateTime       @map("first_response_due_at") @db.Timestamptz
  resolutionDueAt    DateTime       @map("resolution_due_at") @db.Timestamptz
  escalationDueAt    DateTime       @map("escalation_due_at") @db.Timestamptz
  firstRespondedAt   DateTime?      @map("first_responded_at") @db.Timestamptz
  pausedAt           DateTime?      @map("paused_at") @db.Timestamptz // WAITING_CUSTOMER began; due dates shift on resume
  escalatedAt        DateTime?      @map("escalated_at") @db.Timestamptz
  resolvedAt         DateTime?      @map("resolved_at") @db.Timestamptz
  closedAt           DateTime?      @map("closed_at") @db.Timestamptz
  reopenCount        Int            @default(0) @map("reopen_count")
  version            Int            @default(1)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz
  createdBy          String?        @map("created_by") @db.Uuid
  updatedBy          String?        @map("updated_by") @db.Uuid

  zone     Zone            @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refund   Refund?         @relation(fields: [refundId], references: [id], onDelete: Restrict)
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  messages TicketMessage[]

  @@index([zoneId, status, createdAt(sort: Desc)])
  @@index([assigneeId, status])
  @@index([status, escalationDueAt])
  @@index([status, resolutionDueAt])
  @@index([customerId])
  @@index([orderId])
  @@map("support_tickets")
}

model TicketMessage {
  id             String                  @id @db.Uuid
  ticketId       String                  @map("ticket_id") @db.Uuid
  authorId       String                  @map("author_id") @db.Uuid
  visibility     TicketMessageVisibility @default(INTERNAL)
  body           String // CHECK 1..5000 characters: SQL
  attachmentKeys String[]                @default([]) @map("attachment_keys") // upload keys (SA-2.1), at most 5: SQL
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User          @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ---- reward points and wallet ledger (owner 2026-10-20; loyalty settings D101) ------------------------------------

enum RewardEntryType {
  ORDER_EARN // credited when an order is delivered
  ORDER_REVERSAL // an earned credit taken back (order refunded)
  MANUAL_GRANT // an admin adds points with a reason
  MANUAL_DEDUCT // an admin removes points with a reason
  CHECKOUT_REDEEM // points spent as a discount at checkout
  WALLET_CONVERT // points turned into wallet credit
  EXPIRY // unused points past their expiry
}

/// Append-only points ledger: corrections are new rows, never updates of old ones (doc 16).
model RewardPointEntry {
  id             String          @id @db.Uuid
  customerId     String          @map("customer_id") @db.Uuid
  zoneId         String?         @map("zone_id") @db.Uuid // the zone of the order or of the admin action (D63)
  type           RewardEntryType
  points         Int // signed: credits > 0, debits < 0
  balanceAfter   Int             @map("balance_after") // CHECK >= 0: SQL
  // credits only: points of this credit not yet spent or expired (spent oldest first)
  remaining      Int?
  expiresAt      DateTime?       @map("expires_at") @db.Timestamptz // credits only
  orderId        String?         @map("order_id") @db.Uuid
  reason         String?
  actorId        String?         @map("actor_id") @db.Uuid // admin for manual entries; null for system
  idempotencyKey String?         @unique @map("idempotency_key")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  zone     Zone?    @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor    User?    @relation("RewardEntryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt(sort: Desc)])
  @@index([expiresAt]) // expiry job; partial index on open credits in SQL
  @@index([orderId])
  @@map("reward_point_entries")
}

enum WalletEntryType {
  REWARD_CONVERT // credit from reward points
  REFUND_CREDIT // a refund paid to the wallet
  ORDER_DEBIT // wallet spent on an order
  MANUAL_ADJUST // admin correction with a reason
}

/// Append-only wallet ledger; customers.wallet_balance is the running balance (doc 16).
model WalletTransaction {
  id                String          @id @db.Uuid
  customerId        String          @map("customer_id") @db.Uuid
  zoneId            String?         @map("zone_id") @db.Uuid
  type              WalletEntryType
  amountPaise       Int             @map("amount_paise") // signed
  balanceAfterPaise Int             @map("balance_after_paise") // CHECK >= 0: SQL
  refType           String?         @map("ref_type") // reward_point_entry, refund, order
  refId             String?         @map("ref_id") @db.Uuid
  reason            String?
  actorId           String?         @map("actor_id") @db.Uuid
  idempotencyKey    String?         @unique @map("idempotency_key")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  zone     Zone?    @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  actor    User?    @relation("WalletTransactionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt(sort: Desc)])
  @@index([refType, refId])
  @@map("wallet_transactions")
}

// ---- D154 auto-assign (infra session) -----------------------------------------------------------------------------

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model OrderAssignmentOffer {
  id          String      @id @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  partnerId   String      @map("partner_id") @db.Uuid
  zoneId      String      @map("zone_id") @db.Uuid
  rank        Int // 1 = nearest
  distanceM   Int         @map("distance_m")
  status      OfferStatus @default(OFFERED)
  offeredAt   DateTime    @default(now()) @map("offered_at") @db.Timestamptz
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz
  respondedAt DateTime?   @map("responded_at") @db.Timestamptz
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  partner DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  zone    Zone            @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  // at most one OFFERED offer per order: partial unique index in SQL
  @@unique([orderId, rank])
  @@index([status, expiresAt])
  @@index([partnerId, status])
  @@map("order_assignment_offers")
}
