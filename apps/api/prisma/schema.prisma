// ---- menu item change requests and hotels (D118, D119, D124-D127) -------------------------------------------------

enum DietaryType {
  VEGETARIAN
  NON_VEG
  EGG
}

enum MenuChangeKind {
  CREATE
  UPDATE
  DELETE
}

enum MenuChangeStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum DiningStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// separate from the order PaymentStatus
enum BookingPaymentStatus {
  PENDING
  PAID
  REFUNDED
