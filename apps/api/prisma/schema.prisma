}

// ===========================================================================
// IDENTITY AND ACCESS
// ===========================================================================

model User {
  id                 String    @id @db.Uuid
  name               String
  email              String // unique where deleted_at IS NULL: partial index in the constraints migration
  phone              String?
  passwordHash       String    @map("password_hash")
  roleId             String    @map("role_id") @db.Uuid
  status             String // values not given in doc 08 (see handoff)
  phoneVerifiedAt    DateTime? @map("phone_verified_at") @db.Timestamptz
  // derived from user_mfa_methods, updated in the same transaction as any method change (doc 52 section 3)
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid

  role                          Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions                      Session[]
  loginHistory                  LoginHistory[]
  passwordResetTokens           PasswordResetToken[]
  mfaMethods                    UserMfaMethod[]
  mfaChallenges                 MfaChallenge[]
  mfaBackupCodes                MfaBackupCode[]
  preferences                   UserPreference?
  assignments                   AdminZoneAssignment[]   @relation("AssignmentMember")
  assignmentsGranted            AdminZoneAssignment[]   @relation("AssignmentAssignedBy")
  assignmentsRevoked            AdminZoneAssignment[]   @relation("AssignmentRevokedBy")
  restaurantsVerified           Restaurant[]
  homemakersVerified            Homemaker[]
  vendorDocumentsVerified       VendorDocument[]
  cashSettlementsSettled        CashSettlement[]
  refundsRequested              Refund[]                @relation("RefundRequestedBy")
  refundsApproved               Refund[]                @relation("RefundApprovedBy")
  payoutsPaid                   Payout[]
  settingsUpdated               Setting[]
  exportsRequested              Export[]
  dataSubjectRequestsHandled    DataSubjectRequest[]
  integrationAlertsAcknowledged IntegrationAlert[]
  zoneServicesUpdated           ZoneService[]
  zoneSettingsUpdated           ZoneSetting[]           @relation("ZoneSettingUpdatedBy")
  accessRequests                AccessRequest[]         @relation("AccessRequestRequester")
  accessRequestsDecided         AccessRequest[]         @relation("AccessRequestDecidedBy")
  hotelsVerified                Hotel[]                 @relation("HotelVerifier")
  partnersVerified              DeliveryPartner[]       @relation("PartnerVerifier")
  notificationsRequested        Notification[]          @relation("NotificationRequester")
  notificationsDecided          Notification[]          @relation("NotificationDecider")
  menuChangesDecided            MenuItemChangeRequest[] @relation("MenuChangeDecider")
  assignedTickets               SupportTicket[]         @relation("TicketAssignee")
  ticketMessages                TicketMessage[]         @relation("TicketMessageAuthor")
  rewardEntries                 RewardPointEntry[]      @relation("RewardEntryActor")
  walletTransactions            WalletTransaction[]     @relation("WalletTransactionActor")

  @@index([roleId])
  @@map("users")
}

model Role {
  id        String   @id @db.Uuid
  name      RoleName @unique
  isSystem  Boolean  @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users User[]

  @@map("roles")
}

model AccessProfile {
  id                      String    @id @db.Uuid
  name                    String    @unique
  description             String?
  isSeed                  Boolean   @default(false) @map("is_seed")
  defaultPerRefundLimit   Int?      @map("default_per_refund_limit")
  defaultDailyRefundLimit Int?      @map("default_daily_refund_limit")
  defaultCanReveal        Boolean   @default(false) @map("default_can_reveal")
  defaultCanExport        Boolean   @default(false) @map("default_can_export")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz
  createdBy               String?   @map("created_by") @db.Uuid
  updatedBy               String?   @map("updated_by") @db.Uuid

  permissions ProfilePermission[]
  assignments AdminZoneAssignment[]

  @@map("access_profiles")
}

model ProfilePermission {
  profileId String  @map("profile_id") @db.Uuid
  module    String // module key, validated against packages/shared (doc 04 has no machine-readable list)
  canView   Boolean @default(false) @map("can_view")
  canAdd    Boolean @default(false) @map("can_add")
  canEdit   Boolean @default(false) @map("can_edit")
  canDelete Boolean @default(false) @map("can_delete")
  canStatus Boolean @default(false) @map("can_status")
  canExport Boolean @default(false) @map("can_export") // D149

  profile AccessProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@id([profileId, module])
  @@map("profile_permissions")
}

model AdminZoneAssignment {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  zoneId           String    @map("zone_id") @db.Uuid
  profileId        String    @map("profile_id") @db.Uuid
  perRefundLimit   Int?      @map("per_refund_limit") // null = profile default
  dailyRefundLimit Int?      @map("daily_refund_limit") // null = profile default
  canReveal        Boolean?  @map("can_reveal") // null = profile default
  canExport        Boolean?  @map("can_export") // null = profile default
  assignedBy       String    @map("assigned_by") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy        String?   @map("revoked_by") @db.Uuid
  note             String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user        User                 @relation("AssignmentMember", fields: [userId], references: [id], onDelete: Restrict)
  zone        Zone                 @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  profile     AccessProfile        @relation(fields: [profileId], references: [id], onDelete: Restrict)
  assigner    User                 @relation("AssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)
  revoker     User?                @relation("AssignmentRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)
  overrides   AssignmentOverride[]
  refundUsage RefundDailyUsage[]

  // partial unique (user_id, zone_id) WHERE revoked_at IS NULL and partial index (zone_id) WHERE revoked_at IS NULL: constraints migration
  @@index([userId])
  @@index([zoneId])
  @@map("admin_zone_assignments")
}

model AssignmentOverride {
  assignmentId String         @map("assignment_id") @db.Uuid
  module       String
  action       AccessAction
  effect       OverrideEffect

  assignment AdminZoneAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@id([assignmentId, module, action])
  @@map("assignment_overrides")
}

// Append-only (guarded by the audit migration). No foreign keys, like audit_logs: history must outlive users and zones.
model AccessChange {
  id         String           @id @db.Uuid
  actorId    String           @map("actor_id") @db.Uuid
  memberId   String           @map("member_id") @db.Uuid
  zoneId     String?          @map("zone_id") @db.Uuid
  changeType AccessChangeType @map("change_type")
  beforeJson Json?            @map("before_json")
  afterJson  Json?            @map("after_json")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([memberId, createdAt(sort: Desc)])
  @@index([zoneId, createdAt(sort: Desc)])
  @@map("access_changes")
}

model Session {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  ip            String?
  userAgent     String?   @map("user_agent")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // doc 52 section 3. Value lists are Zod enums in @zoauro/shared (auth-mfa.ts), not database enums:
  // mfa_method = MfaType or BACKUP_CODE; reauth_level = PASSWORD | STRONG; restricted = PASSWORD_CHANGE.
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz
  mfaMethod     String?   @map("mfa_method")
  remember      Boolean   @default(false)
  reauthAt      DateTime? @map("reauth_at") @db.Timestamptz
  reauthLevel   String?   @map("reauth_level")
  restricted    String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginHistory {
  id             String   @id @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  emailAttempted String   @map("email_attempted")
  success        Boolean
  ip             String?
  userAgent      String?  @map("user_agent")
  // values: LOGIN_HISTORY_REASONS in @zoauro/shared (auth-mfa.ts); text, like before (doc 52 section 3)
  reason         String?
  // MfaType or BACKUP_CODE, null when no second step was used
  mfaMethod      String?  @map("mfa_method")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("login_history")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

// 2-step verification (doc 52 section 3). The partial unique index (user_id, type) WHERE disabled_at IS NULL is written by
// hand in the migration (Prisma cannot express it).
model UserMfaMethod {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  type            MfaType
  // AUTHENTICATOR only: "v1.<kid>.<nonce>.<ciphertext>.<tag>" (AES-256-GCM, D70)
  secretEncrypted String?   @map("secret_encrypted")
  // null = enrolment started, not confirmed
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz
  // TOTP replay guard: highest accepted step
  lastUsedStep    BigInt?   @map("last_used_step")
  isPrimary       Boolean   @default(false) @map("is_primary")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_mfa_methods")
}

model MfaChallenge {
  id              String     @id @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  purpose         MfaPurpose
  // EMAIL_OTP or SMS_OTP
  method          MfaType
  // HMAC-SHA256(OTP_HMAC_KEY, challengeId || code); the code itself is never stored
  codeHash        String     @map("code_hash")
  // e.g. "a***@x.com", "+91•••••••210"
  destinationHint String     @map("destination_hint")
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz
  attempts        Int        @default(0)
  maxAttempts     Int        @map("max_attempts")
  sendCount       Int        @map("send_count")
  lastSentAt      DateTime   @map("last_sent_at") @db.Timestamptz
  consumedAt      DateTime?  @map("consumed_at") @db.Timestamptz
  ip              String?    @db.Inet
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, method, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

model MfaBackupCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // HMAC-SHA256(OTP_HMAC_KEY, normalised code)
  codeHash  String    @map("code_hash")
  batchId   String    @map("batch_id") @db.Uuid
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, usedAt])
  @@map("mfa_backup_codes")
}

// Copied exactly from the M04 bundle (doc 50 section 3.1). No foreign keys on purpose.
model AuditLog {
  id          String           @id @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  actorType   AuditActorType   @map("actor_type")
  actorId     String?          @map("actor_id") @db.Uuid
  actorName   String           @map("actor_name")
  actorRole   String?          @map("actor_role")
  zoneId      String?          @map("zone_id") @db.Uuid
  module      String
  action      String
  entityType  String           @map("entity_type")
  entityId    String?          @map("entity_id") @db.Uuid
  entityLabel String?          @map("entity_label")
  outcome     AuditOutcome     @default(SUCCESS)
  sensitivity AuditSensitivity @default(NORMAL)
  beforeJson  Json?            @map("before_json")
  afterJson   Json?            @map("after_json")
  note        String?
  ip          String?          @db.Inet
  userAgent   String?          @map("user_agent")
  requestId   String?          @map("request_id")

  @@index([zoneId, id(sort: Desc)])
  @@index([zoneId, module, id(sort: Desc)]) // added after the 2M-row test: zone+module(+action) filters with few or no matches
  @@index([zoneId, module, action, id(sort: Desc)]) // AU-4: zone+module+action with no match (action is not in the index above)
  @@index([entityType, entityId, id(sort: Desc)])
  @@index([actorId, id(sort: Desc)])
  @@index([module, action, id(sort: Desc)])
  @@index([sensitivity, id(sort: Desc)])
  @@map("audit_logs")
}

model UserPreference {
  userId        String   @id @map("user_id") @db.Uuid
  lastZoneScope String?  @map("last_zone_scope") @db.Uuid // null = all zones
  tableDensity  String?  @map("table_density")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  zone Zone? @relation(fields: [lastZoneScope], references: [id], onDelete: Restrict)

  @@map("user_preferences")
}

// ===========================================================================
// GEOGRAPHY
// ===========================================================================

// doc 53 section 3. In migration 20261012110000_zones_schema (Prisma cannot express them): unique lower(name) where
// deleted_at IS NULL (R-ZONE-4) and the CHECKs on code, delivery_charge and the entered pincode range.
model Zone {
  id                 String     @id @db.Uuid
  name               String
  // unique including soft-deleted zones, and never changed after creation (R-ZONE-3)
  code               String     @unique
  city               String
  state              String?
  // the entered range, display only; the truth is serviceable_pincodes
  pincodeFrom        String?    @map("pincode_from") @db.Char(6)
  pincodeTo          String?    @map("pincode_to") @db.Char(6)
  deliveryCharge     Int        @default(0) @map("delivery_charge") // paise, 0..100000 (R-ZONE-5)
  status             ZoneStatus @default(UPCOMING)
  description        String?
  // one of the 12 palette tokens (@zoauro/shared zones/palette.ts)
  colorHex           String     @map("color_hex") @db.Char(7)
  // optimistic locking (R-ZONE-9)
  version            Int        @default(1)
  activatedAt        DateTime?  @map("activated_at") @db.Timestamptz
  deactivatedAt      DateTime?  @map("deactivated_at") @db.Timestamptz
  deactivationReason String?    @map("deactivation_reason")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz
  createdBy          String?    @map("created_by") @db.Uuid
  updatedBy          String?    @map("updated_by") @db.Uuid

  pincodes           ServiceablePincode[]
  assignments        AdminZoneAssignment[]
  preferences        UserPreference[]
  restaurants        Restaurant[]
  homemakers         Homemaker[]
  categories         Category[]
  menuItems          MenuItem[]
  customerAddresses  CustomerAddress[]
  deliveryPartners   DeliveryPartner[]
  cashSettlements    CashSettlement[]
  orders             Order[]
  payouts            Payout[]
  coupons            Coupon[]
  notifications      Notification[]
  outbox             Outbox[]
  inboundLogs        IntegrationInboundLog[]
  services           ZoneService[]
  settings           ZoneSetting[]
  accessRequests     AccessRequest[]
  menuChangeRequests MenuItemChangeRequest[]
  hotels             Hotel[]
  roomBookings       RoomBooking[]
  diningReservations DiningReservation[]
  notificationSends  NotificationZoneSend[]
  supportTickets     SupportTicket[]
  rewardEntries      RewardPointEntry[]
  walletTransactions WalletTransaction[]
  assignmentOffers   OrderAssignmentOffer[]

  @@index([status])
  @@map("zones")
}

// D92 (owner, 2026-10-14): which services run in a zone, switched by a Super Admin only. A row exists only once a
// service was switched; without one the default of ZONE_SERVICE_DEFAULTS (@zoauro/shared) applies.
model ZoneService {
  zoneId    String          @map("zone_id") @db.Uuid
  service   ZoneServiceKind
  enabled   Boolean
  updatedBy String?         @map("updated_by") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  zone    Zone  @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  updater User? @relation(fields: [updatedBy], references: [id], onDelete: Restrict)

  @@id([zoneId, service])
  @@map("zone_services")
}

// doc 53 section 3. A pincode belongs to at most one zone, forever, unless removed (R-ZONE-2): the unique index is global,
// so removing a pincode deletes the row (a soft-deleted row would still hold the pincode).
model ServiceablePincode {
  id        String        @id @db.Uuid
  zoneId    String        @map("zone_id") @db.Uuid
  // CHECK '^[1-9][0-9]{5}$' in migration 20261012110000_zones_schema
  pincode   String        @unique @db.Char(6)
  source    PincodeSource
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz
  createdBy String?       @map("created_by") @db.Uuid
  updatedBy String?       @map("updated_by") @db.Uuid

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([zoneId])
  @@map("serviceable_pincodes")
}

// ===========================================================================
// VENDORS AND MENU
// ===========================================================================

model Restaurant {
  id                   String               @id @db.Uuid
  zoneId               String?              @map("zone_id") @db.Uuid // nullable since v2.0; CHECK with zone_assignment_status in constraints migration
  zoneAssignmentStatus ZoneAssignmentStatus @default(ASSIGNED) @map("zone_assignment_status")
  name                 String
  ownerName            String?              @map("owner_name")
  phone                String?
  email                String?
  address              String?
  area                 String?
  lat                  Decimal?             @db.Decimal(9, 6)
  lng                  Decimal?             @db.Decimal(9, 6)
  cuisineTags          String[]             @map("cuisine_tags")
  commissionPct        Decimal              @default(0) @map("commission_pct") @db.Decimal(5, 2)
  status               VendorStatus         @default(PENDING)
  verificationStatus   VerificationStatus   @default(PENDING) @map("verification_status")
  verificationNote     String?              @map("verification_note")
  verifiedAt           DateTime?            @map("verified_at") @db.Timestamptz
  verifiedBy           String?              @map("verified_by") @db.Uuid
  openingHoursJson     Json?                @map("opening_hours_json")
  logoKey              String?              @map("logo_key")
  minOrder             Int                  @default(0) @map("min_order") // paise
  gstNo                String?              @map("gst_no")
  fssaiNo              String?              @map("fssai_no")
  isOpen               Boolean              @default(false) @map("is_open")
  kind                 RestaurantKind       @default(RESTAURANT)
  source               RecordSource
  sourceUpdatedAt      DateTime?            @map("source_updated_at") @db.Timestamptz
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?            @map("deleted_at") @db.Timestamptz
  createdBy            String?              @map("created_by") @db.Uuid
  updatedBy            String?              @map("updated_by") @db.Uuid

  zone               Zone?                   @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  verifier           User?                   @relation(fields: [verifiedBy], references: [id], onDelete: Restrict)
  menuItems          MenuItem[]
  orders             Order[]
  menuChangeRequests MenuItemChangeRequest[]
  diningReservations DiningReservation[]

  @@index([zoneId, status])
  @@index([zoneId, createdAt(sort: Desc)])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "restaurants_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "restaurants_phone_trgm_idx")
  @@map("restaurants")
}

model Homemaker {
  id                   String               @id @db.Uuid
  zoneId               String?              @map("zone_id") @db.Uuid
  zoneAssignmentStatus ZoneAssignmentStatus @default(ASSIGNED) @map("zone_assignment_status")
  name                 String
  phone                String?
  email                String?
  address              String?
  area                 String?
  lat                  Decimal?             @db.Decimal(9, 6)
  lng                  Decimal?             @db.Decimal(9, 6)
  specialityTags       String[]             @map("speciality_tags")
  foodCategory         String?              @map("food_category") // values not given in doc 08 (see handoff)
  experienceYears      Int?                 @map("experience_years")
  isAvailable          Boolean              @default(true) @map("is_available")
  dailyCapacity        Int                  @default(1) @map("daily_capacity") // CHECK >= 1 in constraints migration
  commissionPct        Decimal              @default(0) @map("commission_pct") @db.Decimal(5, 2)
  status               VendorStatus         @default(PENDING)
  verificationStatus   VerificationStatus   @default(PENDING) @map("verification_status")
  verificationNote     String?              @map("verification_note")
  verifiedAt           DateTime?            @map("verified_at") @db.Timestamptz
  verifiedBy           String?              @map("verified_by") @db.Uuid
  openingHoursJson     Json?                @map("opening_hours_json")
  photoKey             String?              @map("photo_key")
  minOrder             Int                  @default(0) @map("min_order") // paise
  fssaiNo              String?              @map("fssai_no")
  isOpen               Boolean              @default(false) @map("is_open")
  source               RecordSource
  sourceUpdatedAt      DateTime?            @map("source_updated_at") @db.Timestamptz
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?            @map("deleted_at") @db.Timestamptz
  createdBy            String?              @map("created_by") @db.Uuid
  updatedBy            String?              @map("updated_by") @db.Uuid

  zone               Zone?                   @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  verifier           User?                   @relation(fields: [verifiedBy], references: [id], onDelete: Restrict)
  menuItems          MenuItem[]
  orders             Order[]
  menuChangeRequests MenuItemChangeRequest[]

  @@index([zoneId, status])
  @@index([zoneId, createdAt(sort: Desc)])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "homemakers_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "homemakers_phone_trgm_idx")
  @@map("homemakers")
}

model VendorDocument {
  id            String    @id @db.Uuid
  vendorType    String    @map("vendor_type") // values not given in doc 08 (see handoff)
  vendorId      String    @map("vendor_id") @db.Uuid // polymorphic: no foreign key
  docType       String    @map("doc_type")
  fileKey       String    @map("file_key")
  verified      Boolean   @default(false)
  verifiedBy    String?   @map("verified_by") @db.Uuid
  rejectionNote String?   @map("rejection_note")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid

  verifier User? @relation(fields: [verifiedBy], references: [id], onDelete: Restrict)

  @@index([vendorType, vendorId])
  @@map("vendor_documents")
}

model Category {
  id        String    @id @db.Uuid
  zoneId    String?   @map("zone_id") @db.Uuid // null = global
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  zone      Zone?      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  menuItems MenuItem[]

  @@index([zoneId])
  @@map("categories")
}

model MenuItem {
  id              String       @id @db.Uuid
  zoneId          String       @map("zone_id") @db.Uuid
  restaurantId    String?      @map("restaurant_id") @db.Uuid
  homemakerId     String?      @map("homemaker_id") @db.Uuid
  categoryId      String       @map("category_id") @db.Uuid
  name            String
  description     String?
  price           Int // paise
  stock           Int          @default(0)
  isAvailable     Boolean      @default(true) @map("is_available")
  isFeatured      Boolean      @default(false) @map("is_featured")
  imageKey        String?      @map("image_key")
  adminDisabled   Boolean      @default(false) @map("admin_disabled")
  dietary         DietaryType? // D119
  // the last time an admin overrode a vendor-owned field (D119, doc 44)
  adminOverrideAt DateTime?    @map("admin_override_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz
  createdBy       String?      @map("created_by") @db.Uuid
  updatedBy       String?      @map("updated_by") @db.Uuid

  zone           Zone                    @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  restaurant     Restaurant?             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  homemaker      Homemaker?              @relation(fields: [homemakerId], references: [id], onDelete: Restrict)
  category       Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  changeRequests MenuItemChangeRequest[]

  // CHECK exactly one of restaurant_id / homemaker_id: constraints migration
  @@index([zoneId, createdAt(sort: Desc)])
  @@index([restaurantId])
  @@index([homemakerId])
  @@index([categoryId])
  @@map("menu_items")
}

// ===========================================================================
// PEOPLE
// ===========================================================================

model Customer {
  id              String         @id @db.Uuid
  name            String
  phone           String         @unique
  email           String?
  status          CustomerStatus @default(ACTIVE)
  walletBalance   Int            @default(0) @map("wallet_balance") // paise; ledger: wallet_transactions
  rewardPoints    Int            @default(0) @map("reward_points") // ledger: reward_point_entries
  source          String? // doc 08 lists two different value sets (see handoff)
  userType        String         @default("CUSTOMER") @map("user_type")
  sourceUpdatedAt DateTime?      @map("source_updated_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz
  createdBy       String?        @map("created_by") @db.Uuid
  updatedBy       String?        @map("updated_by") @db.Uuid

  addresses           CustomerAddress[]
  orders              Order[]
  reviews             Review[]
  dataSubjectRequests DataSubjectRequest[]
  supportTickets      SupportTicket[]
  rewardEntries       RewardPointEntry[]
  walletTransactions  WalletTransaction[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_phone_trgm_idx")
  @@map("customers")
}

model CustomerAddress {
  id         String    @id @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  label      String?
  address    String
  area       String?
  lat        Decimal?  @db.Decimal(9, 6)
  lng        Decimal?  @db.Decimal(9, 6)
  pincode    String?
  zoneId     String?   @map("zone_id") @db.Uuid
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  zone     Zone?    @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([zoneId])
  @@map("customer_addresses")
}

model DeliveryPartner {
  id                   String               @id @db.Uuid
  zoneId               String?              @map("zone_id") @db.Uuid
  zoneAssignmentStatus ZoneAssignmentStatus @default(ASSIGNED) @map("zone_assignment_status")
  name                 String
  phone                String?
  vehicleType          String?              @map("vehicle_type")
  vehicleNo            String?              @map("vehicle_no")
  area                 String?
  status               PartnerStatus        @default(PENDING_VERIFICATION)
  isOnline             Boolean              @default(false) @map("is_online")
  verifiedAt           DateTime?            @map("verified_at") @db.Timestamptz
  // D130: verification separate from status, like vendors (doc 10 section 4); the R12 queue reads it
  verificationStatus   VerificationStatus   @default(PENDING) @map("verification_status")
  verificationNote     String?              @map("verification_note")
  verifiedBy           String?              @map("verified_by") @db.Uuid
  email                String?
  // optimistic locking (D130)
  version              Int                  @default(1)
  currentOrders        Int                  @default(0) @map("current_orders")
  cashInHand           Int                  @default(0) @map("cash_in_hand") // paise
  ratingAvg            Decimal?             @map("rating_avg") @db.Decimal(3, 2)
  deliveriesCount      Int                  @default(0) @map("deliveries_count")
  forceOfflineUntil    DateTime?            @map("force_offline_until") @db.Timestamptz
  // D154 auto-assign: latest location (plain columns until PostGIS, D164); all three set or none: SQL
  lastLat              Float?               @map("last_lat")
  lastLng              Float?               @map("last_lng")
  lastLocationAt       DateTime?            @map("last_location_at") @db.Timestamptz
  source               RecordSource
  sourceUpdatedAt      DateTime?            @map("source_updated_at") @db.Timestamptz
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?            @map("deleted_at") @db.Timestamptz
  createdBy            String?              @map("created_by") @db.Uuid
  updatedBy            String?              @map("updated_by") @db.Uuid

  zone             Zone?                  @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  orders           Order[]
  cashSettlements  CashSettlement[]
  verifier         User?                  @relation("PartnerVerifier", fields: [verifiedBy], references: [id], onDelete: Restrict)
  assignmentOffers OrderAssignmentOffer[]

  @@index([zoneId, status])
  @@index([zoneId, verificationStatus])
  @@index([zoneId, lastLocationAt])
  @@index([zoneId, createdAt(sort: Desc)])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "delivery_partners_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "delivery_partners_phone_trgm_idx")
  @@map("delivery_partners")
}

model CashSettlement {
  id                String   @id @db.Uuid
  deliveryPartnerId String   @map("delivery_partner_id") @db.Uuid
  zoneId            String   @map("zone_id") @db.Uuid
  expectedAmount    Int      @map("expected_amount") // paise
  handedInAmount    Int      @map("handed_in_amount") // paise
  variance          Int // paise, handed_in - expected
  settledBy         String   @map("settled_by") @db.Uuid
  settledAt         DateTime @map("settled_at") @db.Timestamptz
  note              String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Restrict)
  zone            Zone            @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  settler         User            @relation(fields: [settledBy], references: [id], onDelete: Restrict)

  @@index([zoneId, settledAt(sort: Desc)])
  @@index([deliveryPartnerId])
  @@map("cash_settlements")
}

// ===========================================================================
// ORDERS AND MONEY
// ===========================================================================

model Order {
  id                  String            @id @db.Uuid
  orderNo             String            @unique @map("order_no")
  zoneId              String            @map("zone_id") @db.Uuid
  customerId          String            @map("customer_id") @db.Uuid
  restaurantId        String?           @map("restaurant_id") @db.Uuid
  homemakerId         String?           @map("homemaker_id") @db.Uuid
  deliveryPartnerId   String?           @map("delivery_partner_id") @db.Uuid
  status              OrderStatus       @default(PLACED)
  subtotal            Int // paise
  tax                 Int               @default(0)
  deliveryCharge      Int               @default(0) @map("delivery_charge")
  discount            Int               @default(0)
  total               Int
  commissionPct       Decimal           @map("commission_pct") @db.Decimal(5, 2)
  commissionAmount    Int               @map("commission_amount")
  paymentMethod       PaymentMethod     @map("payment_method")
  paymentSubMethod    PaymentSubMethod? @map("payment_sub_method")
  paymentStatus       PaymentStatus     @default(PENDING) @map("payment_status")
  paymentExpiresAt    DateTime?         @map("payment_expires_at") @db.Timestamptz
  addressSnapshotJson Json              @map("address_snapshot_json")
  // D150/D167 pre-orders: null scheduled_for = order now; dispatch_at = scheduled_for minus prep and travel buffer
  // (set at placement and on reschedule; CHECK dispatch_at <= scheduled_for: SQL); released_at = the dispatch job
  // released it to the vendor and partner apps (hidden until then)
  scheduledFor        DateTime?         @map("scheduled_for") @db.Timestamptz
  dispatchAt          DateTime?         @map("dispatch_at") @db.Timestamptz
  releasedAt          DateTime?         @map("released_at") @db.Timestamptz
  rescheduleCount     Int               @default(0) @map("reschedule_count")
  // delivery point (plain columns until PostGIS, D164; both or neither: SQL); address_snapshot_json unchanged
  deliveryAddress     String?           @map("delivery_address")
  deliveryLat         Decimal?          @map("delivery_lat") @db.Decimal(9, 6)
  deliveryLng         Decimal?          @map("delivery_lng") @db.Decimal(9, 6)
  placedAt            DateTime          @map("placed_at") @db.Timestamptz
  acceptedAt          DateTime?         @map("accepted_at") @db.Timestamptz
  readyAt             DateTime?         @map("ready_at") @db.Timestamptz
  deliveredAt         DateTime?         @map("delivered_at") @db.Timestamptz
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelReason        String?           @map("cancel_reason")
  cancelledBy         String?           @map("cancelled_by") @db.Uuid // actor kind not given in doc 08: no foreign key (see handoff)
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  zone            Zone                 @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  restaurant      Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  homemaker       Homemaker?           @relation(fields: [homemakerId], references: [id], onDelete: Restrict)
  deliveryPartner DeliveryPartner?     @relation(fields: [deliveryPartnerId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  refunds         Refund[]
  ledgerEntries   LedgerEntry[]
  reviews         Review[]

  // CHECK exactly one of restaurant_id / homemaker_id: constraints migration
  supportTickets   SupportTicket[]
  rewardEntries    RewardPointEntry[]
  assignmentOffers OrderAssignmentOffer[]

  @@index([zoneId, status, placedAt(sort: Desc)])
  @@index([customerId])
  @@index([restaurantId])
  @@index([homemakerId])
  @@index([deliveryPartnerId, status])
  @@index([orderNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_order_no_trgm_idx")
  @@map("orders")
}

model OrderItem {
  id            String @id @db.Uuid
  orderId       String @map("order_id") @db.Uuid
  menuItemId    String @map("menu_item_id") @db.Uuid
  nameSnapshot  String @map("name_snapshot")
  priceSnapshot Int    @map("price_snapshot") // paise
  qty           Int

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid // polymorphic with actor_type: no foreign key
  actorType  String       @map("actor_type") // values not given in doc 08 (see handoff)
  note       String?
  sourceApp  String?      @map("source_app")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                String        @id @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String
  providerPaymentId String?       @unique @map("provider_payment_id")
  amount            Int // paise
  status            PaymentStatus @default(PENDING)
  method            String? // doc 08 does not say which value set (see handoff)
  idempotencyKey    String        @unique @map("idempotency_key")
  rawJson           Json?         @map("raw_json")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id               String       @id @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  paymentId        String?      @map("payment_id") @db.Uuid
  amount           Int // paise
  type             String // values not given in doc 08 (see handoff)
  reasonCode       String       @map("reason_code")
  reasonNote       String?      @map("reason_note")
  status           RefundStatus @default(PENDING_APPROVAL)
  requestedBy      String       @map("requested_by") @db.Uuid
  requestedAt      DateTime     @default(now()) @map("requested_at") @db.Timestamptz
  approvedBy       String?      @map("approved_by") @db.Uuid
  decidedAt        DateTime?    @map("decided_at") @db.Timestamptz
  decisionNote     String?      @map("decision_note")
  providerRefundId String?      @map("provider_refund_id")
  idempotencyKey   String       @unique @map("idempotency_key")
  target           RefundTarget
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment        Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requester      User            @relation("RefundRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  approver       User?           @relation("RefundApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  supportTickets SupportTicket[]

  @@index([orderId])
  @@index([paymentId])
  @@index([status, requestedAt(sort: Desc)])
  @@map("refunds")
}

model Payout {
  id         String    @id @db.Uuid
  payeeType  PayeeType @map("payee_type")
  payeeId    String    @map("payee_id") @db.Uuid // polymorphic with payee_type: no foreign key
  zoneId     String    @map("zone_id") @db.Uuid
  periodFrom DateTime  @map("period_from") @db.Date
  periodTo   DateTime  @map("period_to") @db.Date
  gross      Int // paise
  commission Int
  net        Int
  status     String // values not given in doc 08 (see handoff)
  paidAt     DateTime? @map("paid_at") @db.Timestamptz
  paidBy     String?   @map("paid_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  payer User? @relation(fields: [paidBy], references: [id], onDelete: Restrict)

  @@index([zoneId, status])
  @@index([payeeType, payeeId])
  @@map("payouts")
}

// Append-only.
model LedgerEntry {
  id        String   @id @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid // nullable: payouts and settlements have no order (see handoff)
  account   String
  debit     Int      @default(0) // paise
  credit    Int      @default(0) // paise
  refType   String   @map("ref_type")
  refId     String   @map("ref_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([refType, refId])
  @@map("ledger_entries")
}

model WebhookEvent {
  id          String    @id @db.Uuid
  provider    String
  eventId     String    @unique @map("event_id")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz

