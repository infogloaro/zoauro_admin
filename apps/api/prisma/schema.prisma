model ApiClient {
  id              String          @id @db.Uuid
  name            String
  type            ApiClientType
  environment     ApiEnvironment
  keyId           String          @unique @map("key_id")
  scopes          String[]
  ipAllowlist     String[]        @map("ip_allowlist")
  rateLimitPerMin Int             @map("rate_limit_per_min")
  status          ApiClientStatus @default(ACTIVE)
  webhookUrl      String?         @map("webhook_url")
  lastUsedAt      DateTime?       @map("last_used_at") @db.Timestamptz
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz
  createdBy       String?         @map("created_by") @db.Uuid
  updatedBy       String?         @map("updated_by") @db.Uuid

  secrets              ApiClientSecret[]
  externalRefs         ExternalRef[]
  inboundLogs          IntegrationInboundLog[]
  webhookSubscriptions WebhookSubscription[]
  alerts               IntegrationAlert[]

  @@map("api_clients")
