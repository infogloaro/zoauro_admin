  zoneId      String?   @map("zone_id") @db.Uuid
  title       String
  body        String
  channel     String // values not given in doc 08 (see handoff)
  status      String // values not given in doc 08 (see handoff)
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid

  zone Zone? @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([zoneId, createdAt(sort: Desc)])
  @@map("notifications")
}

model Review {
  id         String           @id @db.Uuid
  orderId    String           @map("order_id") @db.Uuid
  customerId String           @map("customer_id") @db.Uuid
  targetType ReviewTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid // polymorphic with target_type: no foreign key
  rating     Int
  comment    String?
  status     ReviewStatus     @default(PUBLISHED)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz
  createdBy  String?          @map("created_by") @db.Uuid
  updatedBy  String?          @map("updated_by") @db.Uuid

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([targetType, targetId])
  @@map("reviews")
}

model Outbox {
  id          String    @id @db.Uuid
  sequence    BigInt    @unique @default(autoincrement()) // feed cursor
  eventType   String    @map("event_type")
  payloadJson Json      @map("payload_json")
