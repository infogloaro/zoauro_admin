model ApiClientSecret {
  id              String    @id @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@map("api_client_secrets")
}

// doc 08 lists no id: the unique (client_id, entity_type, external_id) is the primary key (see handoff)
model ExternalRef {
  entityType String @map("entity_type")
  internalId String @map("internal_id") @db.Uuid // polymorphic with entity_type: no foreign key
  clientId   String @map("client_id") @db.Uuid
  externalId String @map("external_id")

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@id([clientId, entityType, externalId])
  @@index([entityType, internalId])
  @@map("external_refs")
}

model IntegrationInboundLog {
  id               String        @id @db.Uuid
  clientId         String        @map("client_id") @db.Uuid
  requestId        String        @map("request_id")
  idempotencyKey   String?       @map("idempotency_key")
  method           String
  path             String
  entityType       String?       @map("entity_type")
  entityId         String?       @map("entity_id") @db.Uuid
  zoneId           String?       @map("zone_id") @db.Uuid
  result           InboundResult
  errorCode        String?       @map("error_code")
  latencyMs        Int?          @map("latency_ms")
  bodyRedactedJson Json?         @map("body_redacted_json")
  receivedAt       DateTime      @default(now()) @map("received_at") @db.Timestamptz

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  zone   Zone?     @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([clientId, receivedAt])
  @@index([entityId])
  @@map("integration_inbound_log")
}

model WebhookSubscription {
  id              String                    @id @db.Uuid
  clientId        String                    @map("client_id") @db.Uuid
  url             String
  secretEncrypted String                    @map("secret_encrypted")
  eventTypes      String[]                  @map("event_types")
  status          WebhookSubscriptionStatus @default(ACTIVE)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?                 @map("deleted_at") @db.Timestamptz
  createdBy       String?                   @map("created_by") @db.Uuid
  updatedBy       String?                   @map("updated_by") @db.Uuid

  client     ApiClient         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@index([clientId])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String                @id @db.Uuid
  outboxId       String                @map("outbox_id") @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  eventId        String                @map("event_id") // type not given in doc 08 (see handoff)
  attempt        Int                   @default(1)
  status         WebhookDeliveryStatus @default(PENDING)
  httpStatus     Int?                  @map("http_status")
  responseMs     Int?                  @map("response_ms")
  nextAttemptAt  DateTime?             @map("next_attempt_at") @db.Timestamptz
  deliveredAt    DateTime?             @map("delivered_at") @db.Timestamptz
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz

  outbox       Outbox              @relation(fields: [outboxId], references: [id], onDelete: Restrict)
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([outboxId])
  @@index([subscriptionId])
  @@map("webhook_deliveries")
}

model IntegrationAlert {
  id             String               @id @db.Uuid
  clientId       String               @map("client_id") @db.Uuid
  type           IntegrationAlertType
  detailJson     Json?                @map("detail_json")
  acknowledgedBy String?              @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime?            @map("acknowledged_at") @db.Timestamptz
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz

  client       ApiClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  acknowledger User?     @relation(fields: [acknowledgedBy], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt(sort: Desc)])
  @@map("integration_alerts")
}
