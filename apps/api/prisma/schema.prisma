  @@map("hotels")
}

model RoomBooking {
  id            String               @id @db.Uuid
  zoneId        String               @map("zone_id") @db.Uuid
  hotelId       String               @map("hotel_id") @db.Uuid
  customerName  String               @map("customer_name")
  customerPhone String               @map("customer_phone")
  roomType      String               @map("room_type") @db.VarChar(40)
  checkIn       DateTime             @map("check_in") @db.Date
  checkOut      DateTime             @map("check_out") @db.Date // CHECK check_out > check_in: SQL
  guests        Int // CHECK >= 1: SQL
  status        BookingStatus        @default(PENDING)
  paymentStatus BookingPaymentStatus @default(PENDING) @map("payment_status")
  amount        Int // paise, CHECK >= 0: SQL
  note          String?              @db.VarChar(300)
  version       Int                  @default(1)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz
  createdBy     String?              @map("created_by") @db.Uuid
  updatedBy     String?              @map("updated_by") @db.Uuid

