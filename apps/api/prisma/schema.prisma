// ZOAURO Admin — schema for SA-1.1 (Zone Management) + session auth, the
// vendor tables of SA-2 (M06 Restaurants, M07 Homemakers) and the people
// tables of SA-3 (M09 Customers, M10 Delivery Partners).
// Source of truth: docs 08 (schema), 09 (API), 10 §4/§5 (state machines),
// 14 (auth). Remaining operational tables (menu, orders, …) arrive later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Identity role only (doc 08: "no permissions here (v1.2)").
enum RoleKey {
  SUPER_ADMIN
  ZONAL_ADMIN
}

/// doc 08 ZoneStatus (D35 adds UPCOMING).
enum ZoneStatus {
  ACTIVE
  INACTIVE
  UPCOMING
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PartnerSettlementStatus {
  PENDING
  PARTIAL
  SETTLED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

/// Integration posture of a third-party provider, tracked as a configuration
/// flag only. CONFIGURED never implies a live integration — nothing in this
/// module opens a network connection to a provider (task constraint: do not
/// claim an integration is operational). No credential field exists on the
/// model; connectivity and secrets are deliberately out of scope.
enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
}

/// Provider operating status (doc 10 §4-style targets for this module).
enum ThirdPartyProviderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Payment {
  id                String                   @id @default(uuid()) @db.Uuid
  paymentRef        String                   @unique @map("payment_ref")
  orderRef          String                   @map("order_ref")
  customerName      String                   @map("customer_name")
  method            String
  amountPaise       Int                      @map("amount_paise")
  refundAmountPaise Int                      @default(0) @map("refund_amount_paise")
  currency          String                   @default("INR")
  status            PaymentTransactionStatus @default(PENDING)
  demo              Boolean                  @default(false)
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("payments")
}
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleKey  @unique
  isSystem  Boolean  @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]

  @@map("roles")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  name               String
  email              String
  phone              String?
  passwordHash       String     @map("password_hash")
  roleId             String     @map("role_id") @db.Uuid
  role               Role       @relation(fields: [roleId], references: [id])
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  failedAttempts     Int        @default(0) @map("failed_attempts")
  lockedUntil        DateTime?  @map("locked_until")
  lastLoginAt        DateTime?  @map("last_login_at")
  deletedAt          DateTime?  @map("deleted_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  sessions      Session[]
  loginHistory  LoginHistory[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  notifications Notification[]

  // Partial unique (email where deleted_at is null) is created in the SQL
  // migration — Prisma cannot express WHERE clauses on indexes.
  @@index([roleId])
  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id])
  tokenHash         String    @unique @map("token_hash")
  csrfToken         String    @map("csrf_token")
  ip                String?
  userAgent         String?   @map("user_agent")
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  reauthenticatedAt DateTime? @map("reauthenticated_at")
  revokedAt         DateTime? @map("revoked_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model LoginHistory {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  user           User?    @relation(fields: [userId], references: [id])
  emailAttempted String   @map("email_attempted")
  success        Boolean
  ip             String?
  userAgent      String?  @map("user_agent")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("login_history")
}

/// Operational zone (docs 08, 22). Deactivation is a status transition
/// (doc 09: DELETE = deactivate); `deleted_at` is the architecture default
/// for a future true soft-delete and keeps uniqueness semantics explicit.
model Zone {
  id             String     @id @default(uuid()) @db.Uuid
  name           String     @unique
  code           String     @unique
  city           String
  state          String
  pincodeFrom    String?    @map("pincode_from") @db.VarChar(6)
  pincodeTo      String?    @map("pincode_to") @db.VarChar(6)
  deliveryCharge Int        @map("delivery_charge")
  status         ZoneStatus @default(ACTIVE)
  description    String?    @db.VarChar(500)
  colorHex       String     @default("#2F6BFF") @map("color_hex") @db.VarChar(7)
  deletedAt      DateTime?  @map("deleted_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  serviceablePincodes     ServiceablePincode[]
  auditLogs               AuditLog[]
  restaurants             Restaurant[]
  homemakers              Homemaker[]
  hotels                  Hotel[]
  roomBookings            RoomBooking[]
  diningReservations      DiningReservation[]
  menuItems               MenuItem[]
  customerAddresses       CustomerAddress[]
  deliveryPartners        DeliveryPartner[]
  thirdPartyProviderZones ThirdPartyProviderZone[]

  @@index([status])
  @@index([city])
  @@index([state])
  @@map("zones")
}

model ServiceablePincode {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @map("zone_id") @db.Uuid
  zone      Zone     @relation(fields: [zoneId], references: [id])
  pincode   String   @db.VarChar(6)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([zoneId, pincode])
  @@index([pincode])
  @@map("serviceable_pincodes")
}

/// Append-only (doc 08).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  zoneId     String?  @map("zone_id") @db.Uuid
  zone       Zone?    @relation(fields: [zoneId], references: [id])
  module     String
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([module, action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Vendor lifecycle (doc 08 VendorStatus; doc 10 §4): PENDING → ACTIVE only
/// after verification, ACTIVE → INACTIVE, ACTIVE → SUSPENDED → ACTIVE.
enum VendorStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Doc 08 VerificationStatus — independent of status (D22, doc 10 §4).
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// doc 08 `vendor_documents.vendor_type` (+ HOTEL for dining-menu owners).
enum VendorType {
  RESTAURANT
  HOMEMAKER
  HOTEL
}

/// M06 Restaurants (doc 08 "Vendors and menu"). Zone-owned: zone_id NOT NULL.
model Restaurant {
  id                 String             @id @default(uuid()) @db.Uuid
  zoneId             String             @map("zone_id") @db.Uuid
  zone               Zone               @relation(fields: [zoneId], references: [id])
  name               String
  ownerName          String             @map("owner_name")
  phone              String
  email              String?
  address            String
  area               String?            @db.VarChar(80)
  lat                Float?
  lng                Float?
  cuisineTags        String[]           @map("cuisine_tags")
  commissionPct      Float?             @map("commission_pct")
  status             VendorStatus       @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verificationNote   String?            @map("verification_note") @db.VarChar(300)
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  openingHoursJson   Json?              @map("opening_hours_json")
  logoKey            String?            @map("logo_key")
  minOrder           Int?               @map("min_order")
  gstNo              String?            @map("gst_no") @db.VarChar(20)
  fssaiNo            String?            @map("fssai_no") @db.VarChar(20)
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  diningReservations DiningReservation[]

  // Zone-owned list indexes (doc 08 "Indexes and constraints").
  @@index([zoneId, status])
  @@index([zoneId, createdAt])
  @@index([status])
  @@index([verificationStatus])
  @@map("restaurants")
}

/// M07 Homemakers (doc 08). Daily capacity and availability are homemaker-only.
model Homemaker {
  id                 String             @id @default(uuid()) @db.Uuid
  zoneId             String             @map("zone_id") @db.Uuid
  zone               Zone               @relation(fields: [zoneId], references: [id])
  name               String
  phone              String
  email              String?
  address            String
  area               String?            @db.VarChar(80)
  lat                Float?
  lng                Float?
  specialityTags     String[]           @map("speciality_tags")
  foodCategory       String?            @map("food_category") @db.VarChar(60)
  experienceYears    Int?               @map("experience_years")
  isAvailable        Boolean            @default(true) @map("is_available")
  dailyCapacity      Int?               @map("daily_capacity")
  commissionPct      Float?             @map("commission_pct")
  status             VendorStatus       @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verificationNote   String?            @map("verification_note") @db.VarChar(300)
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  openingHoursJson   Json?              @map("opening_hours_json")
  photoKey           String?            @map("photo_key")
  minOrder           Int?               @map("min_order")
  fssaiNo            String?            @map("fssai_no") @db.VarChar(20)
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([zoneId, status])
  @@index([zoneId, createdAt])
  @@index([status])
  @@index([verificationStatus])
  @@map("homemakers")
}

/// doc 08 vendor_documents. Polymorphic on purpose (vendor_type + vendor_id);
/// rows are written once the SA-2.1 uploads service lands.
model VendorDocument {
  id            String     @id @default(uuid()) @db.Uuid
  vendorType    VendorType @map("vendor_type")
  vendorId      String     @map("vendor_id") @db.Uuid
  docType       String     @map("doc_type") @db.VarChar(40)
  fileKey       String     @map("file_key")
  verified      Boolean    @default(false)
  verifiedBy    String?    @map("verified_by") @db.Uuid
  rejectionNote String?    @map("rejection_note") @db.VarChar(300)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([vendorType, vendorId])
  @@map("vendor_documents")
}

/// Hotel room-booking lifecycle (task: Hotel Room Booking Management).
/// PENDING → CONFIRMED → CHECKED_IN → CHECKED_OUT; cancel allowed before
/// check-out. Cancel of a PAID booking marks the payment REFUNDED.
enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

/// Dining reservation lifecycle (Hotel Dining tab).
enum DiningStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Menu/food-item approval workflow (task: Menu & Food Items).
enum MenuApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum DietaryType {
  VEGETARIAN
  NON_VEG
  EGG
}

/// Hotels are zone-owned like restaurants; the vendor lifecycle fields are
/// reused (status + verification, doc 10 §4). Document upload for hotels
/// follows the SA-2.1 polymorphic table once its endpoints extend.
model Hotel {
  id                 String             @id @default(uuid()) @db.Uuid
  zoneId             String             @map("zone_id") @db.Uuid
  zone               Zone               @relation(fields: [zoneId], references: [id])
  name               String
  ownerName          String             @map("owner_name")
  phone              String
  email              String?
  address            String
  area               String?            @db.VarChar(80)
  totalRooms         Int                @map("total_rooms")
  commissionPct      Float?             @map("commission_pct")
  gstNo              String?            @map("gst_no") @db.VarChar(20)
  status             VendorStatus       @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verificationNote   String?            @map("verification_note") @db.VarChar(300)
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  bookings           RoomBooking[]
  diningReservations DiningReservation[]

  @@index([zoneId, status])
  @@index([zoneId, createdAt])
  @@index([status])
  @@index([verificationStatus])
  @@map("hotels")
}

/// Room bookings. Dates are UTC midnights (check-in inclusive, check-out
/// exclusive); overlap prevention is transactional + row-locked in the
/// service. Amount is integer paise.
model RoomBooking {
  id            String        @id @default(uuid()) @db.Uuid
  zoneId        String        @map("zone_id") @db.Uuid
  zone          Zone          @relation(fields: [zoneId], references: [id])
  hotelId       String        @map("hotel_id") @db.Uuid
  hotel         Hotel         @relation(fields: [hotelId], references: [id])
  customerName  String        @map("customer_name")
  customerPhone String        @map("customer_phone")
  roomType      String        @map("room_type") @db.VarChar(40)
  checkIn       DateTime      @map("check_in")
  checkOut      DateTime      @map("check_out")
  guests        Int
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  amount        Int
  note          String?       @db.VarChar(300)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([zoneId, status])
  @@index([hotelId, checkIn])
  @@index([status])
  @@index([paymentStatus])
  @@map("room_bookings")
}

/// Dining reservations at a hotel restaurant or a restaurant. At least one
/// of hotel_id / restaurant_id is set (service-enforced; both may be set for
/// a hotel's in-house dining).
model DiningReservation {
  id            String        @id @default(uuid()) @db.Uuid
  zoneId        String        @map("zone_id") @db.Uuid
  zone          Zone          @relation(fields: [zoneId], references: [id])
  hotelId       String?       @map("hotel_id") @db.Uuid
  hotel         Hotel?        @relation(fields: [hotelId], references: [id])
  restaurantId  String?       @map("restaurant_id") @db.Uuid
  restaurant    Restaurant?   @relation(fields: [restaurantId], references: [id])
  customerName  String        @map("customer_name")
  customerPhone String        @map("customer_phone")
  reservedDate  DateTime      @map("reserved_date")
  reservedTime  String        @map("reserved_time") @db.VarChar(5)
  guests        Int
  tableArea     String?       @map("table_area") @db.VarChar(80)
  status        DiningStatus  @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  amount        Int?
  note          String?       @db.VarChar(300)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([zoneId, status])
  @@index([hotelId, reservedDate])
  @@index([restaurantId])
  @@map("dining_reservations")
}

/// Menu/food items (task: Menu & Food Items; doc 09 `/menu-items`). Exactly
/// one owning provider (vendor_type + vendor_id); items enter PENDING and
/// move through the approval workflow. Price is integer paise.
model MenuItem {
  id              String             @id @default(uuid()) @db.Uuid
  zoneId          String             @map("zone_id") @db.Uuid
  zone            Zone               @relation(fields: [zoneId], references: [id])
  vendorType      VendorType         @map("vendor_type")
  vendorId        String             @map("vendor_id") @db.Uuid
  name            String
  description     String?            @db.VarChar(300)
  category        String?            @db.VarChar(60)
  price           Int
  dietary         DietaryType
  approvalStatus  MenuApprovalStatus @default(PENDING) @map("approval_status")
  rejectionReason String?            @map("rejection_reason") @db.VarChar(300)
  approvedAt      DateTime?          @map("approved_at")
  approvedBy      String?            @map("approved_by") @db.Uuid
  deletedAt       DateTime?          @map("deleted_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([zoneId, approvalStatus])
  @@index([vendorType, vendorId])
  @@index([approvalStatus])
  @@map("menu_items")
}

/// doc 08 People row — CustomerStatus/Source/UserType (doc 08 enums).
/// Not zone-owned (D14): a customer belongs to zones through addresses
/// (D25 visibility = address or order in an in-scope zone). Soft-deleted.
enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerSource {
  APP
  ADMIN
  REFERRAL
  OTHER
}

enum UserType {
  CUSTOMER
}

/// M09 Customers (doc 08 "People", doc 09 `/customers`). Phone is unique
/// (doc 08 "phone (unique)"); the digits-compare guard lives in the service
/// because +91/spacing variants are stored verbatim. Wallet and spend are
/// integer paise.
model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  phone         String         @unique
  email         String?
  status        CustomerStatus @default(ACTIVE)
  source        CustomerSource @default(APP)
  userType      UserType       @default(CUSTOMER) @map("user_type")
  walletBalance Int            @default(0) @map("wallet_balance")
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  addresses CustomerAddress[]

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@map("customers")
}

/// doc 08 `customer_addresses` — the customer's zone footprint (D25).
model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])
  label      String?  @db.VarChar(40)
  address    String   @db.VarChar(240)
  area       String?  @db.VarChar(80)
  lat        Float?
  lng        Float?
  pincode    String?  @db.VarChar(6)
  zoneId     String   @map("zone_id") @db.Uuid
  zone       Zone     @relation(fields: [zoneId], references: [id])
  isDefault  Boolean  @default(true) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@index([zoneId])
  @@index([zoneId, area])
  @@map("customer_addresses")
}

/// doc 08 DeliveryPartnerStatus (doc 10 §5): PENDING_VERIFICATION → VERIFIED
/// → ACTIVE ⇄ INACTIVE; SUSPENDED. Availability (`isOnline`) is separate from
/// status (doc 10 §5) and is toggled by the partner app; the admin force
/// offline writes `force_offline_until` (doc 08 v2.0 column). Money is
/// integer paise; `ratingAvg` is a 0–5 average (not money).
enum DeliveryPartnerStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// M10 Delivery Partners (doc 08, doc 09 `/delivery-partners`). Exactly one
/// zone (doc 36 §4, R-DEL-2); soft-deleted by default.
model DeliveryPartner {
  id                 String                  @id @default(uuid()) @db.Uuid
  zoneId             String                  @map("zone_id") @db.Uuid
  zone               Zone                    @relation(fields: [zoneId], references: [id])
  name               String
  phone              String
  vehicleType        String                  @map("vehicle_type") @db.VarChar(40)
  vehicleNo          String?                 @map("vehicle_no") @db.VarChar(20)
  area               String?                 @db.VarChar(80)
  status             DeliveryPartnerStatus   @default(PENDING_VERIFICATION)
  isOnline           Boolean                 @default(false) @map("is_online")
  forceOfflineUntil  DateTime?               @map("force_offline_until")
  verifiedAt         DateTime?               @map("verified_at")
  currentOrders      Int                     @default(0) @map("current_orders")
  cashInHand         Int                     @default(0) @map("cash_in_hand")
  ratingAvg          Float?                  @map("rating_avg")
  deliveriesCount    Int                     @default(0) @map("deliveries_count")
  /**
   * Task-authorized performance columns (Own Delivery Partners page). Seeded
   * in dev/test; maintained by the orders pipeline once M11 lands.
   */
  ordersAssigned     Int                     @default(0) @map("orders_assigned")
  failedDeliveries   Int                     @default(0) @map("failed_deliveries")
  avgDeliveryMinutes Int?                    @map("avg_delivery_minutes")
  onTimePct          Int?                    @map("on_time_pct")
  earningsPaise      Int                     @default(0) @map("earnings_paise")
  settlementStatus   PartnerSettlementStatus @default(PENDING) @map("settlement_status")
  deletedAt          DateTime?               @map("deleted_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@index([zoneId, status])
  @@index([zoneId, createdAt])
  @@index([status])
  @@index([isOnline])
  @@index([createdAt])
  @@map("delivery_partners")
}

/// Third-Party Partners (task: `/super-admin/third-party-partners`). A provider
/// is an external delivery **company**, not an individual, and its rows are
/// never mixed with `DeliveryPartner` (M10) — the two modules keep separate
/// tables, routes and screens. Coverage is many-to-many with zones (doc 36)
/// through `ThirdPartyProviderZone`, so there is no single `zone_id`.
/// Metric columns are seeded in dev/test and maintained by the orders
/// pipeline once M11 lands. Soft-deleted by default (AGENTS.md).
model ThirdPartyProvider {
  id                   String                   @id @default(uuid()) @db.Uuid
  name                 String
  providerType         String                   @map("provider_type") @db.VarChar(40)
  contactPerson        String                   @map("contact_person")
  contactEmail         String                   @map("contact_email")
  contactPhone         String                   @map("contact_phone")
  status               ThirdPartyProviderStatus @default(ACTIVE)
  integrationStatus    IntegrationStatus        @default(NOT_CONFIGURED) @map("integration_status")
  deliveriesCount      Int                      @default(0) @map("deliveries_count")
  successfulDeliveries Int                      @default(0) @map("successful_deliveries")
  failedDeliveries     Int                      @default(0) @map("failed_deliveries")
  avgDeliveryMinutes   Int?                     @map("avg_delivery_minutes")
  providerCostPaise    Int                      @default(0) @map("provider_cost_paise")
  settlementStatus     PartnerSettlementStatus  @default(PENDING) @map("settlement_status")
  zones                ThirdPartyProviderZone[]
  deletedAt            DateTime?                @map("deleted_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("third_party_providers")
}

/// Coverage link: which zones a third-party provider operates in. Many-to-many
/// (doc 36); the unique pair keeps a zone listed once per provider.
model ThirdPartyProviderZone {
  id         String             @id @default(uuid()) @db.Uuid
  providerId String             @map("provider_id") @db.Uuid
  provider   ThirdPartyProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  zoneId     String             @map("zone_id") @db.Uuid
  zone       Zone               @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now()) @map("created_at")

  @@unique([providerId, zoneId])
  @@index([zoneId])
  @@map("third_party_provider_zones")
}

model Notification {
  id               String    @id @default(uuid()) @db.Uuid
  recipientId      String    @map("recipient_id") @db.Uuid
  recipient        User      @relation(fields: [recipientId], references: [id])
  eventType        String    @map("event_type")
  title            String
  message          String
  relatedType      String?   @map("related_type")
  relatedId        String?   @map("related_id") @db.Uuid
  navigationTarget String?   @map("navigation_target")
  idempotencyKey   String?   @map("idempotency_key")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([recipientId, idempotencyKey])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("notifications")
}
