}

/// A proposed menu change (R09, D119): the approved value stays live until a decision.
model MenuItemChangeRequest {
  id                  String           @id @db.Uuid
  zoneId              String           @map("zone_id") @db.Uuid
  menuItemId          String?          @map("menu_item_id") @db.Uuid
  restaurantId        String?          @map("restaurant_id") @db.Uuid
  homemakerId         String?          @map("homemaker_id") @db.Uuid
  externalItemId      String?          @map("external_item_id")
  kind                MenuChangeKind
  status              MenuChangeStatus @default(PENDING)
  proposedJson        Json             @map("proposed_json")
  baseJson            Json?            @map("base_json")
  source              RecordSource
  submittedByClientId String?          @map("submitted_by_client_id") @db.Uuid
  decidedBy           String?          @map("decided_by") @db.Uuid
  decidedAt           DateTime?        @map("decided_at") @db.Timestamptz
  decisionReason      String?          @map("decision_reason")
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  zone        Zone        @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  menuItem    MenuItem?   @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  restaurant  Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  homemaker   Homemaker?  @relation(fields: [homemakerId], references: [id], onDelete: Restrict)
  submittedBy ApiClient?  @relation(fields: [submittedByClientId], references: [id], onDelete: Restrict)
  decider     User?       @relation("MenuChangeDecider", fields: [decidedBy], references: [id], onDelete: Restrict)

  // partial uniques (one PENDING per item; per client and external id for CREATE) and the one-vendor CHECK: SQL
  @@index([zoneId, status, createdAt])
  @@index([menuItemId])
  @@map("menu_item_change_requests")
}

/// Hotel room booking (D91, D118).
model Hotel {
  id                 String             @id @db.Uuid
  zoneId             String             @map("zone_id") @db.Uuid
  name               String
  ownerName          String             @map("owner_name")
  phone              String
  email              String?
  address            String
  area               String?
  totalRooms         Int                @map("total_rooms") // CHECK >= 0: SQL
  commissionPct      Decimal            @default(0) @map("commission_pct") @db.Decimal(5, 2)
  gstNo              String?            @map("gst_no")
  status             VendorStatus       @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verificationNote   String?            @map("verification_note")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz
  verifiedBy         String?            @map("verified_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz
  createdBy          String?            @map("created_by") @db.Uuid
  updatedBy          String?            @map("updated_by") @db.Uuid

  zone               Zone                @relation(fields: [zoneId], references: [id], onDelete: Restrict)
