# Copy to apps/api/.env for local development. Values below are dev-only and match docker-compose.dev.yml.
# Real environments inject secrets from the secrets manager (doc 12). Never commit .env.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# API and worker connect as zoauro_app only.
DATABASE_URL=postgresql://zoauro_app:zoauro_app_dev@127.0.0.1:5441/zoauro
# Prisma commands (pnpm db:migrate) and CI only: zoauro_owner. Never set in a production API or worker.
DATABASE_URL_MIGRATE=postgresql://zoauro_owner:zoauro_owner_dev@127.0.0.1:5441/zoauro
# Audit retention job (zoauro_purge). Optional in dev; required for the worker in production.
DATABASE_URL_AUDIT_PURGE=postgresql://zoauro_purge:zoauro_purge_dev@127.0.0.1:5441/zoauro

REDIS_URL=redis://127.0.0.1:6390

# Dev placeholders only (min 32 characters). Generate real values per environment.
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
ENCRYPTION_KEY=dev-only-encryption-key-change-me-0123456789
# 2-step verification (doc 52): its own secret, at least 32 characters, different from SESSION_SECRET and ENCRYPTION_KEY.
OTP_HMAC_KEY=dev-only-otp-hmac-key-change-me-0123456789
# Only while rotating ENCRYPTION_KEY: the previous value, so secrets sealed with it still open.
# ENCRYPTION_KEY_PREVIOUS=
MFA_ISSUER=ZOAURO Admin
# SMS one-time codes stay off until a real provider and a DLT template exist (doc 52 section 6). console = local only.
# msg91 (D68): SMS_API_KEY = MSG91 auth key, SMS_TEMPLATE_ID_OTP = MSG91 flow template id (variables ##otp## and
# ##minutes##), SMS_DLT_TEMPLATE_ID_OTP = the DLT template id registered for it (needed to switch SMS on in the policy).
SMS_PROVIDER=none
# SMS_API_KEY=
# SMS_TEMPLATE_ID_OTP=
# SMS_DLT_TEMPLATE_ID_OTP=

S3_BUCKET=zoauro-dev
S3_REGION=ap-south-1
S3_ENDPOINT=http://127.0.0.1:9020
# Local MinIO only (docker-compose.dev.yml); production uses the task role, never keys in files
AWS_ACCESS_KEY_ID=zoauro_minio
AWS_SECRET_ACCESS_KEY=zoauro_minio_dev

SMTP_URL=smtp://127.0.0.1:1025

# Outbound webhooks to the apps (D129): dev logs and marks delivered; http sends signed requests (doc 43).
INTEGRATION_WEBHOOK_DELIVERY=dev

LOG_LEVEL=info

# Proxies in front of the API that may set X-Forwarded-For (req.ip): 0 locally, 1 behind one Nginx.
TRUST_PROXY_HOPS=0

# Optional, uncomment when needed.
# SENTRY_DSN=
# PAYMENT_PROVIDER=
# INITIAL_SUPERADMIN_EMAIL=
# INITIAL_SUPERADMIN_PASSWORD=
