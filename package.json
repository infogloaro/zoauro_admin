{
  "name": "zoauro-admin",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @zoauro/web --filter @zoauro/api dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @zoauro/api db:migrate",
    "db:seed": "pnpm --filter @zoauro/api db:seed",
    "prepare": "husky",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d && docker compose -f docker-compose.dev.yml up -d --wait postgres redis minio mailpit",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "e2e:system-logs": "pnpm --filter @zoauro/api exec tsx ../../tests/e2e/system-logs/run.ts",
    "e2e:auth": "pnpm --filter @zoauro/api exec tsx ../../tests/e2e/auth/run.ts",
    "e2e:flows": "pnpm --filter @zoauro/api exec tsx ../../tests/e2e/flows/run.ts",
    "e2e:shell": "playwright test -c tests/e2e/shell/playwright.config.ts",
    "openapi:generate": "pnpm --filter @zoauro/api openapi:generate",
    "openapi:check": "pnpm --filter @zoauro/api openapi:check"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
