{
  "schemaVersion": 1,
  "envelope": {
    "required": ["eventId", "type", "schemaVersion", "occurredAt", "sequence", "aggregate", "audience", "data"],
    "notes": "Delivered by signed webhook and by GET /intake/v1/events. At-least-once; dedupe on eventId; apply only if aggregate.version is newer."
  },
  "events": [
    {"type": "order.status_changed", "to": ["CUSTOMER_APP","VENDOR_APP","PARTNER_APP"], "data": {"from": "OrderStatus", "to": "OrderStatus", "note": "string?"}},
    {"type": "order.assigned", "to": ["PARTNER_APP","VENDOR_APP","CUSTOMER_APP"], "data": {"partnerId": "externalId", "partnerName": "string", "etaMin": "int?"}},
    {"type": "order.reassigned", "to": ["PARTNER_APP","CUSTOMER_APP"], "data": {"fromPartnerId": "externalId", "toPartnerId": "externalId"}},
    {"type": "order.cancelled", "to": ["CUSTOMER_APP","VENDOR_APP","PARTNER_APP"], "data": {"reasonCode": "string", "cancelledBy": "CUSTOMER|VENDOR|ADMIN|SYSTEM", "refundExpected": "bool"}},
    {"type": "payment.status_changed", "to": ["CUSTOMER_APP"], "data": {"orderId": "externalId", "paymentStatus": "PENDING|PAID|FAILED|PARTIALLY_REFUNDED|REFUNDED", "amountPaise": "int"}},
    {"type": "refund.updated", "to": ["CUSTOMER_APP"], "data": {"orderId": "externalId", "refundId": "uuid", "status": "REQUESTED|PENDING_APPROVAL|APPROVED|PROCESSED|REJECTED|FAILED", "amountPaise": "int", "target": "ORIGINAL|WALLET|MANUAL"}},
    {"type": "vendor.status_changed", "to": ["VENDOR_APP"], "data": {"verificationStatus": "PENDING|VERIFIED|REJECTED", "status": "PENDING|ACTIVE|INACTIVE|SUSPENDED", "note": "string?"}},
    {"type": "vendor.updated", "to": ["VENDOR_APP"], "data": {"fields": "object of admin-owned fields changed (commissionPct, zoneId, zoneName)"}},
    {"type": "menu_item.admin_changed", "to": ["VENDOR_APP","CUSTOMER_APP"], "data": {"itemId": "externalId", "adminDisabled": "bool", "reason": "string?"}},
    {"type": "menu_item.change_decided", "to": ["VENDOR_APP"], "data": {"requestId": "uuid", "kind": "CREATE|UPDATE|DELETE", "decision": "APPROVED|REJECTED", "itemId": "externalId (ours when none)", "menuItemId": "uuid?", "reason": "string? (rejected)"}},
    {"type": "partner.status_changed", "to": ["PARTNER_APP"], "data": {"verificationStatus": "PENDING|VERIFIED|REJECTED", "status": "PENDING_VERIFICATION|VERIFIED|ACTIVE|INACTIVE|SUSPENDED", "note": "string?"}},
    {"type": "partner.force_offline", "to": ["PARTNER_APP"], "data": {"reason": "string", "until": "iso8601"}},
    {"type": "partner.updated", "to": ["PARTNER_APP"], "data": {"fields": "object of admin-owned fields changed (zoneId, zoneName); D131"}},
    {"type": "customer.status_changed", "to": ["CUSTOMER_APP"], "data": {"status": "ACTIVE|BLOCKED"}},
    {"type": "settlement.confirmed", "to": ["PARTNER_APP"], "data": {"settlementId": "uuid", "confirmedPaise": "int", "variancePaise": "int"}},
    {"type": "zone.updated", "to": ["CUSTOMER_APP","VENDOR_APP","PARTNER_APP"], "data": {"zoneId": "uuid", "name": "string", "status": "ACTIVE|INACTIVE|UPCOMING", "pincodeRange": "string", "deliveryChargePaise": "int"}},
    {"type": "config.changed", "to": ["CUSTOMER_APP","VENDOR_APP","PARTNER_APP"], "data": {"keys": ["string"]}},
    {"type": "broadcast.created", "to": ["CUSTOMER_APP","VENDOR_APP","PARTNER_APP"], "data": {"audienceType": "CUSTOMERS|VENDORS|PARTNERS|ALL", "zoneIds": ["uuid"], "title": "string", "body": "string", "channels": ["PUSH","SMS","IN_APP"], "sendAt": "iso8601?"}}
  ]
}
