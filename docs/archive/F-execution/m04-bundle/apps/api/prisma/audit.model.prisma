// Paste into prisma/schema.prisma (Dev 1, Prompt 3 / task AU-1). Doc 50 §3.1. No foreign keys on purpose.
enum AuditActorType { USER APP_CLIENT SYSTEM WEBHOOK }
enum AuditOutcome { SUCCESS DENIED }
enum AuditSensitivity { NORMAL HIGH }

model AuditLog {
  id          String           @id @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  actorType   AuditActorType   @map("actor_type")
  actorId     String?          @map("actor_id") @db.Uuid
  actorName   String           @map("actor_name")
  actorRole   String?          @map("actor_role")
  zoneId      String?          @map("zone_id") @db.Uuid
  module      String
  action      String
  entityType  String           @map("entity_type")
  entityId    String?          @map("entity_id") @db.Uuid
  entityLabel String?          @map("entity_label")
  outcome     AuditOutcome     @default(SUCCESS)
  sensitivity AuditSensitivity @default(NORMAL)
  beforeJson  Json?            @map("before_json")
  afterJson   Json?            @map("after_json")
  note        String?
  ip          String?          @db.Inet
  userAgent   String?          @map("user_agent")
  requestId   String?          @map("request_id")

  @@index([zoneId, id(sort: Desc)])
  @@index([zoneId, module, id(sort: Desc)]) // added after the 2M-row test: zone+module(+action) filters with few or no matches
  @@index([entityType, entityId, id(sort: Desc)])
  @@index([actorId, id(sort: Desc)])
  @@index([module, action, id(sort: Desc)])
  @@index([sensitivity, id(sort: Desc)])
  @@map("audit_logs")
}
