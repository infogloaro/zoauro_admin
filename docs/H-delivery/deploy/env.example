# Non-secret values (.env). Secrets (.env.secrets) come from Secrets Manager; never commit either file.
NODE_ENV=production
APP_URL=https://admin.example.com
WEB_INTERNAL_API_URL=http://api:4000
S3_BUCKET=zoauro-prod-uploads
S3_REGION=ap-south-1
PAYMENT_PROVIDER=razorpay            # D6, undecided
LOG_LEVEL=info
INTEGRATION_CLOCK_SKEW_SEC=300
INTEGRATION_WEBHOOK_TIMEOUT_MS=10000
INTEGRATION_FEED_RETENTION_DAYS=14
# Secrets (.env.secrets): DATABASE_URL, REDIS_URL, SESSION_SECRET, ENCRYPTION_KEY, PAYMENT_KEY_ID, PAYMENT_KEY_SECRET,
# PAYMENT_WEBHOOK_SECRET, SENTRY_DSN, SES/SMTP credentials, INITIAL_SUPERADMIN_EMAIL, INITIAL_SUPERADMIN_PASSWORD
